{
  "name": "boringcharts",
  "version": "0.1.0",
  "description": "Small, strictly typed SVG charts for React",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "demo": "vite demo --host 127.0.0.1",
    "build:demo": "vite build demo --outDir ../demo-dist --emptyOutDir",
    "typecheck:demo": "tsc -p demo/tsconfig.json --noEmit"
  },
  "peerDependencies": { "react": ">=18" },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "license": "MIT"
}
